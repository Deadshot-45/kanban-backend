# MongoDB Atlas connection string (Required for production/Vercel)
MONGODB_URI=mongodb+srv://<username>:<password>@cluster.mongodb.net/kanban?retryWrites=true&w=majority

# Port (used for local server)
PORT=5000

# Client frontend URL (for CORS and email invite links)
CLIENT_URL=https://your-frontend-domain.vercel.app

# Email credentials for member invitation emails (optional)
EMAIL_USER=your-email@gmail.com
EMAIL_PASS=your-app-password
